# Shared settings, prepended to every tape by docs/media/record.sh.
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 15
Set Width 1440
Set Height 820
Set Padding 14
Set Framerate 20
Set TypingSpeed 55ms
Set WindowBar Colorful
Set BorderRadius 8
Set Margin 0
Set Theme { "name": "island-dark", "background": "#1e1f22", "foreground": "#bcbec4", "cursor": "#ced0d6", "selection": "#2d416b", "black": "#2b2d30", "red": "#f75464", "green": "#6aab73", "yellow": "#f2c55c", "blue": "#56a8f5", "magenta": "#c77dbb", "cyan": "#2aacb8", "white": "#bcbec4", "brightBlack": "#6f737a", "brightRed": "#ff7a85", "brightGreen": "#8ccf95", "brightYellow": "#ffd57e", "brightBlue": "#7cbcff", "brightMagenta": "#e09ad4", "brightCyan": "#4cc7d3", "brightWhite": "#ced0d6" }
