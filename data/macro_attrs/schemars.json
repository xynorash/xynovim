{
  "crate": "schemars",
  "versions": ">=0.8.0, <2.0.0",
  "docs_url": "https://graham.cool/schemars/deriving/attributes/",
  "attributes": [
    {
      "name": "schemars",
      "derives": [
        "JsonSchema"
      ],
      "applies_to": [
        "container",
        "field",
        "variant"
      ],
      "docs_url": "https://graham.cool/schemars/deriving/attributes/",
      "args": [
        {
          "key": "rename",
          "kind": "string",
          "doc": "Name this item is described with.",
          "snippet": "rename = \"${1:name}\""
        },
        {
          "key": "rename_all",
          "kind": "enum",
          "doc": "Rename all fields or variants (serde-compatible).",
          "applies_to": [
            "container",
            "variant"
          ],
          "values": [
            "lowercase",
            "UPPERCASE",
            "PascalCase",
            "camelCase",
            "snake_case",
            "SCREAMING_SNAKE_CASE",
            "kebab-case",
            "SCREAMING-KEBAB-CASE"
          ],
          "quoted": true
        },
        {
          "key": "rename_all_fields",
          "kind": "enum",
          "doc": "Rename the fields of all struct variants.",
          "applies_to": [
            "container:enum"
          ],
          "values": [
            "lowercase",
            "UPPERCASE",
            "PascalCase",
            "camelCase",
            "snake_case",
            "SCREAMING_SNAKE_CASE",
            "kebab-case",
            "SCREAMING-KEBAB-CASE"
          ],
          "quoted": true,
          "since": "0.8.16"
        },
        {
          "key": "deny_unknown_fields",
          "kind": "flag",
          "doc": "Set additionalProperties to false.",
          "applies_to": [
            "container"
          ]
        },
        {
          "key": "tag",
          "kind": "string",
          "doc": "Internally/adjacently tagged enum representation.",
          "applies_to": [
            "container"
          ],
          "conflicts": [
            "untagged"
          ],
          "snippet": "tag = \"${1:type}\""
        },
        {
          "key": "content",
          "kind": "string",
          "doc": "Adjacently tagged: field holding the contents.",
          "applies_to": [
            "container:enum"
          ],
          "requires": [
            "tag"
          ],
          "conflicts": [
            "untagged"
          ],
          "snippet": "content = \"${1:content}\""
        },
        {
          "key": "untagged",
          "kind": "flag",
          "doc": "Untagged enum representation.",
          "applies_to": [
            "container:enum",
            "variant"
          ],
          "conflicts": [
            "tag",
            "content"
          ]
        },
        {
          "key": "default",
          "kind": "flag",
          "doc": "The field or struct has a default value.",
          "applies_to": [
            "container",
            "field"
          ],
          "alt": [
            {
              "label": "default = \"path\"",
              "snippet": "default = \"${1:path::to::fn}\"",
              "doc": "Call this function for the default."
            }
          ]
        },
        {
          "key": "skip",
          "kind": "flag",
          "doc": "Leave this field or variant out of the schema.",
          "applies_to": [
            "field",
            "variant"
          ]
        },
        {
          "key": "skip_serializing",
          "kind": "flag",
          "doc": "Leave out when describing serialization.",
          "applies_to": [
            "field",
            "variant"
          ]
        },
        {
          "key": "skip_deserializing",
          "kind": "flag",
          "doc": "Leave out when describing deserialization.",
          "applies_to": [
            "field",
            "variant"
          ]
        },
        {
          "key": "flatten",
          "kind": "flag",
          "doc": "Flatten the schema of this field into the container.",
          "applies_to": [
            "field"
          ]
        },
        {
          "key": "with",
          "kind": "string",
          "doc": "Describe this field as another type.",
          "applies_to": [
            "field",
            "variant"
          ],
          "snippet": "with = \"${1:Type}\""
        },
        {
          "key": "schema_with",
          "kind": "path",
          "doc": "Function generating the schema of this field.",
          "applies_to": [
            "field",
            "container",
            "variant"
          ],
          "snippet": "schema_with = \"${1:path::to::fn}\""
        },
        {
          "key": "title",
          "kind": "string",
          "doc": "Title of the schema.",
          "snippet": "title = \"${1:title}\""
        },
        {
          "key": "description",
          "kind": "string",
          "doc": "Description (default: the doc comment).",
          "snippet": "description = \"${1:text}\""
        },
        {
          "key": "example",
          "kind": "expr",
          "doc": "Example value.",
          "snippet": "example = ${1:expr}"
        },
        {
          "key": "deprecated",
          "kind": "flag",
          "doc": "Mark as deprecated.",
          "applies_to": [
            "container",
            "field",
            "variant"
          ]
        },
        {
          "key": "crate",
          "kind": "string",
          "doc": "Path to the schemars crate.",
          "applies_to": [
            "container"
          ],
          "snippet": "crate = \"${1:schemars}\""
        },
        {
          "key": "bound",
          "kind": "string",
          "doc": "Bounds of the generated impl.",
          "applies_to": [
            "container"
          ],
          "snippet": "bound = \"${1:T: JsonSchema}\""
        },
        {
          "key": "transparent",
          "kind": "flag",
          "doc": "Describe a newtype as its field.",
          "applies_to": [
            "container:struct"
          ]
        },
        {
          "key": "inline",
          "kind": "flag",
          "doc": "Inline the schema instead of a $ref.",
          "applies_to": [
            "container",
            "field"
          ]
        },
        {
          "key": "extend",
          "kind": "expr",
          "doc": "Add custom keywords to the schema: extend(\"x-key\" = value).",
          "snippet": "extend(\"${1:x-key}\" = ${2:value})"
        },
        {
          "key": "transform",
          "kind": "expr",
          "doc": "Transform the generated schema with a function.",
          "since": "1.0.0",
          "snippet": "transform = ${1:path::to::fn}"
        },
        {
          "key": "range",
          "kind": "expr",
          "doc": "Numeric range: range(min = 1, max = 10).",
          "applies_to": [
            "field"
          ],
          "snippet": "range(min = ${1:0}, max = ${2:100})"
        },
        {
          "key": "length",
          "kind": "expr",
          "doc": "String or array length: length(min = 1, max = 10).",
          "applies_to": [
            "field"
          ],
          "snippet": "length(min = ${1:1}, max = ${2:10})"
        },
        {
          "key": "regex",
          "kind": "expr",
          "doc": "Regex pattern: regex(pattern = \"...\").",
          "applies_to": [
            "field"
          ],
          "snippet": "regex(pattern = \"${1:^[a-z]+$}\")"
        },
        {
          "key": "contains",
          "kind": "string",
          "doc": "String contains this substring.",
          "applies_to": [
            "field"
          ],
          "snippet": "contains = \"${1:text}\""
        },
        {
          "key": "email",
          "kind": "flag",
          "doc": "Format: email.",
          "applies_to": [
            "field"
          ]
        },
        {
          "key": "url",
          "kind": "flag",
          "doc": "Format: uri.",
          "applies_to": [
            "field"
          ]
        },
        {
          "key": "required",
          "kind": "flag",
          "doc": "Mark an Option field as required.",
          "applies_to": [
            "field"
          ]
        }
      ]
    }
  ]
}
