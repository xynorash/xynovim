{
  "crate": "clap",
  "versions": ">=4.0.0, <5.0.0",
  "docs_url": "https://docs.rs/clap/latest/clap/_derive/index.html",
  "attributes": [
    {
      "name": "command",
      "derives": [
        "Parser",
        "Args",
        "Subcommand"
      ],
      "applies_to": [
        "container",
        "variant",
        "field"
      ],
      "args": [
        {
          "key": "name",
          "kind": "string",
          "doc": "The command name (default: the crate or variant name in kebab-case).",
          "snippet": "name = \"${1:name}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "version",
          "kind": "flag",
          "doc": "Show the version (from Cargo.toml) with -V/--version; or set it with `version = \"...\"`.",
          "alt": [
            {
              "label": "version = \"...\"",
              "snippet": "version = \"${1:1.0.0}\"",
              "doc": "Set an explicit version string."
            }
          ],
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "author",
          "kind": "flag",
          "doc": "Show the author(s) (from Cargo.toml); or set them with `author = \"...\"`.",
          "alt": [
            {
              "label": "author = \"...\"",
              "snippet": "author = \"${1:name}\"",
              "doc": "Set explicit author text."
            }
          ],
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "about",
          "kind": "flag",
          "doc": "Short description (default: the doc comment or Cargo.toml description); or `about = \"...\"`.",
          "alt": [
            {
              "label": "about = \"...\"",
              "snippet": "about = \"${1:text}\"",
              "doc": "Set explicit about text."
            }
          ],
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "long_about",
          "kind": "flag",
          "doc": "Long description for --help; or `long_about = \"...\"`.",
          "alt": [
            {
              "label": "long_about = \"...\"",
              "snippet": "long_about = \"${1:text}\"",
              "doc": "Set explicit long about text."
            }
          ],
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "verbatim_doc_comment",
          "kind": "flag",
          "doc": "Keep the doc comment's line breaks and markup as written.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "subcommand_required",
          "kind": "bool",
          "doc": "A subcommand must be given.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "arg_required_else_help",
          "kind": "bool",
          "doc": "Show the help when no arguments are given.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "propagate_version",
          "kind": "bool",
          "doc": "Propagate the version to subcommands.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "next_line_help",
          "kind": "bool",
          "doc": "Put the help of all arguments on the line after the name.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "disable_help_flag",
          "kind": "bool",
          "doc": "Do not add -h/--help (add your own, e.g. ArgAction::HelpShort).",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "disable_help_subcommand",
          "kind": "bool",
          "doc": "Do not add the `help` subcommand.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "disable_version_flag",
          "kind": "bool",
          "doc": "Do not add -V/--version.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "disable_colored_help",
          "kind": "bool",
          "doc": "Do not colour the help.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "args_conflicts_with_subcommands",
          "kind": "bool",
          "doc": "Arguments and subcommands are mutually exclusive.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "subcommand_precedence_over_arg",
          "kind": "bool",
          "doc": "A subcommand name wins over a positional value.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "allow_external_subcommands",
          "kind": "bool",
          "doc": "Treat unknown subcommands as external (use with an `external_subcommand` variant).",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "infer_subcommands",
          "kind": "bool",
          "doc": "Accept unambiguous prefixes of subcommands.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "infer_long_args",
          "kind": "bool",
          "doc": "Accept unambiguous prefixes of long flags.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "allow_hyphen_values",
          "kind": "bool",
          "doc": "Allow values starting with a hyphen.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "hide",
          "kind": "bool",
          "doc": "Hide this subcommand from the help.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "multicall",
          "kind": "bool",
          "doc": "Choose the subcommand from argv[0] (busybox style).",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "trailing_var_arg",
          "kind": "bool",
          "doc": "The last positional collects everything after it.",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "bin_name",
          "kind": "string",
          "doc": "Name of the binary in usage lines.",
          "snippet": "bin_name = \"${1:name}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "display_name",
          "kind": "string",
          "doc": "Name shown in the help of a multicall binary.",
          "snippet": "display_name = \"${1:name}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "help_template",
          "kind": "string",
          "doc": "Template of the whole help message.",
          "snippet": "help_template = \"${1:{before-help}{name} {version}\\n{about}\\n\\n{usage-heading} {usage}\\n\\n{all-args}}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "after_help",
          "kind": "string",
          "doc": "Text after the help.",
          "snippet": "after_help = \"${1:text}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "after_long_help",
          "kind": "string",
          "doc": "Text after the --help (long) output.",
          "snippet": "after_long_help = \"${1:text}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "before_help",
          "kind": "string",
          "doc": "Text before the help.",
          "snippet": "before_help = \"${1:text}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "before_long_help",
          "kind": "string",
          "doc": "Text before the --help (long) output.",
          "snippet": "before_long_help = \"${1:text}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "override_usage",
          "kind": "string",
          "doc": "Replace the generated usage line.",
          "snippet": "override_usage = \"${1:usage}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "override_help",
          "kind": "string",
          "doc": "Replace the whole generated help.",
          "snippet": "override_help = \"${1:help}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "alias",
          "kind": "string",
          "doc": "Hidden alias of the subcommand.",
          "repeatable": true,
          "snippet": "alias = \"${1:name}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "aliases",
          "kind": "expr",
          "doc": "Hidden aliases of the subcommand.",
          "snippet": "aliases = [${1:\"name\"}]",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "visible_alias",
          "kind": "string",
          "doc": "Alias shown in the help.",
          "repeatable": true,
          "snippet": "visible_alias = \"${1:name}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "styles",
          "kind": "expr",
          "doc": "Colour styles of the help (clap::builder::Styles).",
          "snippet": "styles = ${1:STYLES}",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "color",
          "kind": "enum",
          "doc": "When to colour the output.",
          "values": [
            "clap::ColorChoice::Auto",
            "clap::ColorChoice::Always",
            "clap::ColorChoice::Never"
          ],
          "snippet": "color = ${1:clap::ColorChoice::Auto}",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "term_width",
          "kind": "int",
          "doc": "Terminal width used to wrap the help.",
          "snippet": "term_width = ${1:80}",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "max_term_width",
          "kind": "int",
          "doc": "Largest width used to wrap the help.",
          "snippet": "max_term_width = ${1:100}",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "next_display_order",
          "kind": "int",
          "doc": "Display order of the first argument.",
          "snippet": "next_display_order = ${1:0}",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "rename_all",
          "kind": "enum",
          "doc": "Case style of generated names (arguments or subcommands).",
          "values": [
            "camel",
            "kebab",
            "pascal",
            "screaming-snake",
            "snake",
            "lower",
            "upper",
            "verbatim"
          ],
          "quoted": true,
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "rename_all_env",
          "kind": "enum",
          "doc": "Case style of generated environment variable names.",
          "values": [
            "camel",
            "kebab",
            "pascal",
            "screaming-snake",
            "snake",
            "lower",
            "upper",
            "verbatim"
          ],
          "quoted": true,
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "subcommand_value_name",
          "kind": "string",
          "doc": "Placeholder for the subcommand in the usage.",
          "snippet": "subcommand_value_name = \"${1:COMMAND}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "subcommand_help_heading",
          "kind": "string",
          "doc": "Heading of the subcommand list.",
          "snippet": "subcommand_help_heading = \"${1:Commands}\"",
          "applies_to": [
            "container",
            "variant"
          ]
        },
        {
          "key": "skip",
          "kind": "flag",
          "doc": "Do not generate anything for this field or variant.",
          "applies_to": [
            "field",
            "variant"
          ]
        },
        {
          "key": "subcommand",
          "kind": "flag",
          "doc": "This field holds the subcommand (an enum deriving Subcommand).",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "flatten"
          ]
        },
        {
          "key": "flatten",
          "kind": "flag",
          "doc": "Flatten the arguments of this field's type (deriving Args) into this command.",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "subcommand"
          ]
        },
        {
          "key": "external_subcommand",
          "kind": "flag",
          "doc": "This variant receives unknown subcommands (with allow_external_subcommands).",
          "applies_to": [
            "variant"
          ]
        }
      ]
    },
    {
      "name": "arg",
      "derives": [
        "Parser",
        "Args"
      ],
      "applies_to": [
        "field"
      ],
      "args": [
        {
          "key": "short",
          "kind": "flag",
          "doc": "Short flag; the first letter of the field name, or `short = 'x'`.",
          "applies_to": [
            "field"
          ],
          "alt": [
            {
              "label": "short = 'c'",
              "snippet": "short = '${1:c}'",
              "doc": "Choose the short flag character."
            }
          ]
        },
        {
          "key": "long",
          "kind": "flag",
          "doc": "Long flag; the field name in kebab-case, or `long = \"name\"`.",
          "applies_to": [
            "field"
          ],
          "alt": [
            {
              "label": "long = \"name\"",
              "snippet": "long = \"${1:name}\"",
              "doc": "Choose the long flag name."
            }
          ]
        },
        {
          "key": "value_name",
          "kind": "string",
          "doc": "Placeholder of the value in the usage and help.",
          "applies_to": [
            "field"
          ],
          "snippet": "value_name = \"${1:VALUE}\""
        },
        {
          "key": "default_value",
          "kind": "string",
          "doc": "Default value as a string (parsed like command-line input).",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "default_value_t",
            "default_values_t",
            "required"
          ],
          "snippet": "default_value = \"${1:value}\""
        },
        {
          "key": "default_value_t",
          "kind": "expr",
          "doc": "Default value as a Rust value (uses Default, or give an expression).",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "default_value",
            "default_values_t",
            "required"
          ],
          "alt": [
            {
              "label": "default_value_t = expr",
              "snippet": "default_value_t = ${1:expr}",
              "doc": "Use this expression as the default."
            }
          ]
        },
        {
          "key": "default_values_t",
          "kind": "expr",
          "doc": "Default values of a multi-value argument as Rust values.",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "default_value",
            "default_value_t",
            "required"
          ],
          "snippet": "default_values_t = ${1:vec![]}"
        },
        {
          "key": "default_missing_value",
          "kind": "string",
          "doc": "Value used when the flag is given without a value.",
          "applies_to": [
            "field"
          ],
          "snippet": "default_missing_value = \"${1:value}\""
        },
        {
          "key": "env",
          "kind": "flag",
          "doc": "Read the value from an environment variable (named after the field), or `env = \"NAME\"`.",
          "applies_to": [
            "field"
          ],
          "alt": [
            {
              "label": "env = \"NAME\"",
              "snippet": "env = \"${1:NAME}\"",
              "doc": "Choose the environment variable."
            }
          ]
        },
        {
          "key": "num_args",
          "kind": "expr",
          "doc": "Number of values: 1, 1.., 1..=3, 0..=1 ...",
          "applies_to": [
            "field"
          ],
          "snippet": "num_args = ${1:1..}"
        },
        {
          "key": "required",
          "kind": "bool",
          "doc": "The argument must be given.",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "default_value",
            "default_value_t",
            "default_values_t"
          ]
        },
        {
          "key": "value_enum",
          "kind": "flag",
          "doc": "Parse the value as a ValueEnum (the type derives clap::ValueEnum).",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "value_parser"
          ]
        },
        {
          "key": "value_parser",
          "kind": "expr",
          "doc": "Parser of the value, e.g. clap::value_parser!(u16).range(1..) or a function.",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "value_enum"
          ],
          "snippet": "value_parser = ${1:clap::value_parser!(u16)}"
        },
        {
          "key": "action",
          "kind": "enum",
          "doc": "What happens when the argument is seen.",
          "applies_to": [
            "field"
          ],
          "values": [
            "ArgAction::Set",
            "ArgAction::Append",
            "ArgAction::SetTrue",
            "ArgAction::SetFalse",
            "ArgAction::Count",
            "ArgAction::Help",
            "ArgAction::HelpShort",
            "ArgAction::HelpLong",
            "ArgAction::Version"
          ],
          "snippet": "action = ${1:clap::ArgAction::SetTrue}"
        },
        {
          "key": "global",
          "kind": "bool",
          "doc": "The argument is available on all subcommands.",
          "applies_to": [
            "field"
          ]
        },
        {
          "key": "hide",
          "kind": "bool",
          "doc": "Hide the argument from the help.",
          "applies_to": [
            "field"
          ]
        },
        {
          "key": "help",
          "kind": "string",
          "doc": "Short help (default: the first paragraph of the doc comment).",
          "applies_to": [
            "field"
          ],
          "snippet": "help = \"${1:text}\""
        },
        {
          "key": "long_help",
          "kind": "string",
          "doc": "Long help shown with --help.",
          "applies_to": [
            "field"
          ],
          "snippet": "long_help = \"${1:text}\""
        },
        {
          "key": "help_heading",
          "kind": "string",
          "doc": "Group the argument under this heading in the help.",
          "applies_to": [
            "field"
          ],
          "snippet": "help_heading = \"${1:Heading}\""
        },
        {
          "key": "conflicts_with",
          "kind": "string",
          "doc": "Cannot be used together with this argument id.",
          "applies_to": [
            "field"
          ],
          "repeatable": true,
          "snippet": "conflicts_with = \"${1:arg}\""
        },
        {
          "key": "conflicts_with_all",
          "kind": "expr",
          "doc": "Cannot be used together with any of these argument ids.",
          "applies_to": [
            "field"
          ],
          "snippet": "conflicts_with_all = [${1:\"arg\"}]"
        },
        {
          "key": "requires",
          "kind": "string",
          "doc": "Requires this other argument id.",
          "applies_to": [
            "field"
          ],
          "repeatable": true,
          "snippet": "requires = \"${1:arg}\""
        },
        {
          "key": "requires_all",
          "kind": "expr",
          "doc": "Requires all of these argument ids.",
          "applies_to": [
            "field"
          ],
          "snippet": "requires_all = [${1:\"arg\"}]"
        },
        {
          "key": "required_unless_present",
          "kind": "string",
          "doc": "Required unless this argument id is present.",
          "applies_to": [
            "field"
          ],
          "snippet": "required_unless_present = \"${1:arg}\""
        },
        {
          "key": "required_if_eq",
          "kind": "expr",
          "doc": "Required if another argument has this value: (\"arg\", \"value\").",
          "applies_to": [
            "field"
          ],
          "snippet": "required_if_eq(${1:\"arg\"}, ${2:\"value\"})"
        },
        {
          "key": "group",
          "kind": "string",
          "doc": "Put the argument into this ArgGroup id.",
          "applies_to": [
            "field"
          ],
          "snippet": "group = \"${1:group}\""
        },
        {
          "key": "groups",
          "kind": "expr",
          "doc": "Put the argument into these ArgGroup ids.",
          "applies_to": [
            "field"
          ],
          "snippet": "groups = [${1:\"group\"}]"
        },
        {
          "key": "id",
          "kind": "string",
          "doc": "Explicit argument id (default: the field name).",
          "applies_to": [
            "field"
          ],
          "snippet": "id = \"${1:id}\""
        },
        {
          "key": "index",
          "kind": "int",
          "doc": "Position of a positional argument (1-based).",
          "applies_to": [
            "field"
          ],
          "snippet": "index = ${1:1}"
        },
        {
          "key": "value_delimiter",
          "kind": "flag",
          "doc": "Split the value on this character: `value_delimiter = ','`.",
          "applies_to": [
            "field"
          ],
          "snippet": "value_delimiter = '${1:,}'"
        },
        {
          "key": "value_hint",
          "kind": "expr",
          "doc": "Shell completion hint (clap::ValueHint::FilePath ...).",
          "applies_to": [
            "field"
          ],
          "snippet": "value_hint = ${1:clap::ValueHint::FilePath}"
        },
        {
          "key": "alias",
          "kind": "string",
          "doc": "Hidden alias of a long flag.",
          "applies_to": [
            "field"
          ],
          "repeatable": true,
          "snippet": "alias = \"${1:name}\""
        },
        {
          "key": "aliases",
          "kind": "expr",
          "doc": "Hidden aliases of a long flag.",
          "applies_to": [
            "field"
          ],
          "snippet": "aliases = [${1:\"name\"}]"
        },
        {
          "key": "visible_alias",
          "kind": "string",
          "doc": "Alias of a long flag shown in the help.",
          "applies_to": [
            "field"
          ],
          "repeatable": true,
          "snippet": "visible_alias = \"${1:name}\""
        },
        {
          "key": "short_alias",
          "kind": "flag",
          "doc": "Hidden alias of a short flag.",
          "applies_to": [
            "field"
          ],
          "snippet": "short_alias = '${1:c}'"
        },
        {
          "key": "last",
          "kind": "bool",
          "doc": "Positional that only matches after `--`.",
          "applies_to": [
            "field"
          ]
        },
        {
          "key": "trailing_var_arg",
          "kind": "bool",
          "doc": "This positional collects everything after it.",
          "applies_to": [
            "field"
          ]
        },
