{
  "crate": "derive_more",
  "versions": ">=1.0.0, <3.0.0",
  "docs_url": "https://docs.rs/derive_more/latest/derive_more/",
  "attributes": [
    {
      "name": "display",
      "derives": [
        "Display"
      ],
      "applies_to": [
        "container",
        "variant",
        "field"
      ],
      "args": [
        {
          "key": "\"...\"",
          "kind": "string",
          "doc": "Format string of the Display impl; `{_0}`, `{field}`, `{_variant}` refer to fields.",
          "positional": true,
          "snippet": "\"${1:{_0}}\""
        },
        {
          "key": "bound",
          "kind": "expr",
          "doc": "Where-clause bounds of the generated impl.",
          "snippet": "bound(${1:T: Display})"
        }
      ]
    },
    {
      "name": "debug",
      "derives": [
        "Debug"
      ],
      "applies_to": [
        "container",
        "variant",
        "field"
      ],
      "args": [
        {
          "key": "\"...\"",
          "kind": "string",
          "doc": "Format string of the Debug impl for this field or variant.",
          "positional": true,
          "snippet": "\"${1:{_0}}\""
        },
        {
          "key": "skip",
          "kind": "flag",
          "doc": "Leave this field out of the Debug output.",
          "applies_to": [
            "field"
          ]
        },
        {
          "key": "bound",
          "kind": "expr",
          "doc": "Where-clause bounds of the generated impl.",
          "applies_to": [
            "container"
          ],
          "snippet": "bound(${1:T: Debug})"
        }
      ]
    },
    {
      "name": "error",
      "derives": [
        "Error"
      ],
      "applies_to": [
        "container",
        "variant",
        "field"
      ],
      "args": [
        {
          "key": "source",
          "kind": "flag",
          "doc": "Use this field as the error's source().",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "not"
          ]
        },
        {
          "key": "not(source)",
          "kind": "flag",
          "doc": "This field is not the error's source().",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "source"
          ],
          "snippet": "not(source)"
        },
        {
          "key": "ignore",
          "kind": "flag",
          "doc": "Same as not(source).",
          "applies_to": [
            "field"
          ]
        }
      ]
    },
    {
      "name": "from",
      "derives": [
        "From"
      ],
      "applies_to": [
        "container",
        "variant",
        "field"
      ],
      "args": [
        {
          "key": "forward",
          "kind": "flag",
          "doc": "Convert from anything the field type converts from."
        },
        {
          "key": "skip",
          "kind": "flag",
          "doc": "Generate no From for this variant."
        }
      ]
    },
    {
      "name": "into",
      "derives": [
        "Into"
      ],
      "applies_to": [
        "container",
        "field"
      ],
      "args": [
        {
          "key": "owned",
          "kind": "flag",
          "doc": "Convert the owned value."
        },
        {
          "key": "ref",
          "kind": "flag",
          "doc": "Convert from a shared reference."
        },
        {
          "key": "ref_mut",
          "kind": "flag",
          "doc": "Convert from a mutable reference."
        },
        {
          "key": "skip",
          "kind": "flag",
          "doc": "Do not include this field.",
          "applies_to": [
            "field"
          ]
        }
      ]
    },
    {
      "name": "as_ref",
      "derives": [
        "AsRef"
      ],
      "applies_to": [
        "field"
      ],
      "args": [
        {
          "key": "forward",
          "kind": "flag",
          "doc": "Forward to the field's own AsRef impl.",
          "applies_to": [
            "field"
          ]
        }
      ]
    },
    {
      "name": "as_mut",
      "derives": [
        "AsMut"
      ],
      "applies_to": [
        "field"
      ],
      "args": [
        {
          "key": "forward",
          "kind": "flag",
          "doc": "Forward to the field's own AsMut impl.",
          "applies_to": [
            "field"
          ]
        }
      ]
    },
    {
      "name": "deref",
      "derives": [
        "Deref"
      ],
      "applies_to": [
        "field"
      ],
      "args": [
        {
          "key": "forward",
          "kind": "flag",
          "doc": "Deref to the target of the field's own Deref.",
          "applies_to": [
            "field"
          ]
        }
      ]
    },
    {
      "name": "deref_mut",
      "derives": [
        "DerefMut"
      ],
      "applies_to": [
        "field"
      ],
      "args": [
        {
          "key": "forward",
          "kind": "flag",
          "doc": "DerefMut to the target of the field's own DerefMut.",
          "applies_to": [
            "field"
          ]
        }
      ]
    },
    {
      "name": "try_from",
      "derives": [
        "TryFrom"
      ],
      "applies_to": [
        "container"
      ],
      "args": []
    },
    {
      "name": "from_str",
      "derives": [
        "FromStr"
      ],
      "applies_to": [
        "container"
      ],
      "args": [
        {
          "key": "novalidate",
          "kind": "flag",
          "doc": "Do not validate the input.",
          "applies_to": [
            "container"
          ]
        }
      ]
    },
    {
      "name": "is_variant",
      "derives": [
        "IsVariant"
      ],
      "applies_to": [
        "variant"
      ],
      "args": [
        {
          "key": "ignore",
          "kind": "flag",
          "doc": "Do not generate is_* for this variant.",
          "applies_to": [
            "variant"
          ]
        }
      ]
    },
    {
      "name": "unwrap",
      "derives": [
        "Unwrap"
      ],
      "applies_to": [
        "variant"
      ],
      "args": [
        {
          "key": "ignore",
          "kind": "flag",
          "doc": "Do not generate unwrap_* for this variant.",
          "applies_to": [
            "variant"
          ]
        }
      ]
    },
    {
      "name": "try_unwrap",
      "derives": [
        "TryUnwrap"
      ],
      "applies_to": [
        "variant"
      ],
      "args": [
        {
          "key": "ignore",
          "kind": "flag",
          "doc": "Do not generate try_unwrap_* for this variant.",
          "applies_to": [
            "variant"
          ]
        }
      ]
    }
  ]
}
