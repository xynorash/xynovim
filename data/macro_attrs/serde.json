{
  "crate": "serde",
  "versions": ">=1.0.0, <2.0.0",
  "docs_url": "https://serde.rs/attributes.html",
  "attributes": [
    {
      "name": "serde",
      "derives": [
        "Serialize",
        "Deserialize"
      ],
      "applies_to": [
        "container",
        "field",
        "variant"
      ],
      "docs_url": "https://serde.rs/attributes.html",
      "args": [
        {
          "key": "rename",
          "kind": "string",
          "doc": "Serialize and deserialize this item under the given name instead of its Rust name.",
          "applies_to": [
            "container",
            "field",
            "variant"
          ],
          "nested": [
            "serialize",
            "deserialize"
          ],
          "snippet": "rename = \"${1:name}\"",
          "doc_url": "https://serde.rs/attributes.html"
        },
        {
          "key": "rename_all",
          "kind": "enum",
          "doc": "Rename all fields (struct) or variants (enum) according to the given case convention.",
          "applies_to": [
            "container",
            "variant"
          ],
          "values": [
            "lowercase",
            "UPPERCASE",
            "PascalCase",
            "camelCase",
            "snake_case",
            "SCREAMING_SNAKE_CASE",
            "kebab-case",
            "SCREAMING-KEBAB-CASE"
          ],
          "quoted": true,
          "nested": [
            "serialize",
            "deserialize"
          ]
        },
        {
          "key": "rename_all_fields",
          "kind": "enum",
          "doc": "Rename the fields of all struct variants of this enum according to the given case convention.",
          "applies_to": [
            "container:enum"
          ],
          "values": [
            "lowercase",
            "UPPERCASE",
            "PascalCase",
            "camelCase",
            "snake_case",
            "SCREAMING_SNAKE_CASE",
            "kebab-case",
            "SCREAMING-KEBAB-CASE"
          ],
          "quoted": true,
          "since": "1.0.195",
          "nested": [
            "serialize",
            "deserialize"
          ]
        },
        {
          "key": "deny_unknown_fields",
          "kind": "flag",
          "doc": "Always error during deserialization when encountering unknown fields.",
          "applies_to": [
            "container"
          ]
        },
        {
          "key": "tag",
          "kind": "string",
          "doc": "On an enum: internally tagged representation, the variant name is stored in this field. On a struct: the struct name is written as this field.",
          "applies_to": [
            "container"
          ],
          "conflicts": [
            "untagged"
          ],
          "snippet": "tag = \"${1:type}\""
        },
        {
          "key": "content",
          "kind": "string",
          "doc": "On an enum with `tag`: adjacently tagged representation, the contents go in this field.",
          "applies_to": [
            "container:enum"
          ],
          "conflicts": [
            "untagged"
          ],
          "requires": [
            "tag"
          ],
          "snippet": "content = \"${1:content}\""
        },
        {
          "key": "untagged",
          "kind": "flag",
          "doc": "Serialize and deserialize without a tag: the variants are tried in order.",
          "applies_to": [
            "container:enum",
            "variant"
          ],
          "conflicts": [
            "tag",
            "content"
          ]
        },
        {
          "key": "default",
          "kind": "flag",
          "doc": "Use Default::default() (or the given function) for missing fields when deserializing.",
          "applies_to": [
            "container",
            "field"
          ],
          "alt": [
            {
              "label": "default = \"path\"",
              "snippet": "default = \"${1:path::to::fn}\"",
              "doc": "Call this function for missing values."
            }
          ]
        },
        {
          "key": "skip",
          "kind": "flag",
          "doc": "Skip this field or variant in both serialization and deserialization.",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "skip_serializing",
            "skip_deserializing",
            "skip_serializing_if",
            "serialize_with",
            "deserialize_with",
            "with",
            "rename",
            "alias",
            "flatten",
            "borrow"
          ]
        },
        {
          "key": "skip_serializing",
          "kind": "flag",
          "doc": "Skip this field or variant when serializing.",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "skip",
            "serialize_with",
            "with",
            "skip_serializing_if"
          ]
        },
        {
          "key": "skip_deserializing",
          "kind": "flag",
          "doc": "Skip this field or variant when deserializing (the field gets its default).",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "skip",
            "deserialize_with",
            "with",
            "alias"
          ]
        },
        {
          "key": "skip_serializing_if",
          "kind": "path",
          "doc": "Call a function to decide whether to skip serializing this field, e.g. Option::is_none.",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "skip",
            "skip_serializing"
          ],
          "snippet": "skip_serializing_if = \"${1:Option::is_none}\""
        },
        {
          "key": "flatten",
          "kind": "flag",
          "doc": "Flatten the contents of this field into the container it is defined in.",
          "applies_to": [
            "field"
          ],
          "conflicts": [
            "skip",
            "rename"
          ]
        },
        {
          "key": "with",
          "kind": "path",
          "doc": "Use a module with `serialize` and `deserialize` functions for this field or variant.",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "serialize_with",
            "deserialize_with",
            "skip"
          ],
          "snippet": "with = \"${1:module}\""
        },
        {
          "key": "serialize_with",
          "kind": "path",
          "doc": "Serialize this field using the function `fn<S: Serializer>(&T, S) -> Result<S::Ok, S::Error>`.",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "with",
            "skip",
            "skip_serializing"
          ],
          "snippet": "serialize_with = \"${1:path::to::fn}\""
        },
        {
          "key": "deserialize_with",
          "kind": "path",
          "doc": "Deserialize this field using the function `fn<'de, D: Deserializer<'de>>(D) -> Result<T, D::Error>`.",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "with",
            "skip",
            "skip_deserializing"
          ],
          "snippet": "deserialize_with = \"${1:path::to::fn}\""
        },
        {
          "key": "alias",
          "kind": "string",
          "doc": "Accept this additional name when deserializing (may be repeated).",
          "applies_to": [
            "field",
            "variant"
          ],
          "repeatable": true,
          "conflicts": [
            "skip",
            "skip_deserializing"
          ],
          "snippet": "alias = \"${1:name}\""
        },
        {
          "key": "bound",
          "kind": "string",
          "doc": "Where-clause bounds on the generated impl, replacing the inferred ones.",
          "applies_to": [
            "container",
            "field",
            "variant"
          ],
          "nested": [
            "serialize",
            "deserialize"
          ],
          "snippet": "bound = \"${1:T: Trait}\""
        },
        {
          "key": "transparent",
          "kind": "flag",
          "doc": "Serialize and deserialize a newtype or single-field struct as the field itself.",
          "applies_to": [
            "container:struct"
          ],
          "conflicts": [
            "from",
            "try_from",
            "into",
            "tag",
            "deny_unknown_fields"
          ]
        },
        {
          "key": "from",
          "kind": "string",
          "doc": "Deserialize by first deserializing this type and converting with From.",
          "applies_to": [
            "container"
          ],
          "conflicts": [
            "try_from",
            "transparent"
          ],
          "snippet": "from = \"${1:Type}\""
        },
        {
          "key": "try_from",
          "kind": "string",
          "doc": "Deserialize by first deserializing this type and converting with TryFrom.",
          "applies_to": [
            "container"
          ],
          "conflicts": [
            "from",
            "transparent"
          ],
          "snippet": "try_from = \"${1:Type}\""
        },
        {
          "key": "into",
          "kind": "string",
          "doc": "Serialize by converting into this type with Into first.",
          "applies_to": [
            "container"
          ],
          "conflicts": [
            "transparent"
          ],
          "snippet": "into = \"${1:Type}\""
        },
        {
          "key": "getter",
          "kind": "path",
          "doc": "Remote derive: read this private field through a getter function.",
          "applies_to": [
            "field"
          ],
          "snippet": "getter = \"${1:path::to::fn}\""
        },
        {
          "key": "remote",
          "kind": "string",
          "doc": "Derive this impl for a type defined in another crate (definition mirrors the remote type).",
          "applies_to": [
            "container"
          ],
          "snippet": "remote = \"${1:Type}\""
        },
        {
          "key": "borrow",
          "kind": "flag",
          "doc": "Borrow data for this field from the deserializer (optionally for given lifetimes).",
          "applies_to": [
            "field",
            "variant"
          ],
          "conflicts": [
            "skip"
          ],
          "alt": [
            {
              "label": "borrow = \"'a\"",
              "snippet": "borrow = \"'${1:a}\"",
              "doc": "Borrow only for these lifetimes."
            }
          ]
        },
        {
          "key": "crate",
          "kind": "path",
          "doc": "Path to the serde crate when it is renamed or re-exported.",
          "applies_to": [
            "container"
          ],
          "snippet": "crate = \"${1:serde}\""
        },
        {
          "key": "expecting",
          "kind": "string",
          "doc": "Custom text of the 'expecting ...' part of the deserialization error.",
          "applies_to": [
            "container"
          ],
          "since": "1.0.133",
          "snippet": "expecting = \"${1:message}\""
        },
        {
          "key": "other",
          "kind": "flag",
          "doc": "Deserialize unknown variants into this variant (internally/adjacently tagged enums).",
          "applies_to": [
            "variant"
          ],
          "since": "1.0.131"
        },
        {
          "key": "field_identifier",
          "kind": "flag",
          "doc": "This enum is an identifier of fields; unit variants and one newtype variant.",
          "applies_to": [
            "container:enum"
          ]
        },
        {
          "key": "variant_identifier",
          "kind": "flag",
          "doc": "This enum is an identifier of variants.",
          "applies_to": [
            "container:enum"
          ]
        }
      ]
    }
  ]
}
